{
	"name": "handlebars-spec",
	"version": "204.7.9",
	"description": "JSON test fixtures derived from the Handlebars.js test suite",
	"author": "John Boehr <jbboehr@gmail.com>",
	"contributors": [
		"Kasper Isager <kasperisager@gmail.com>"
	],
	"license": "AGPL-3.0-or-later",
	"repository": "https://github.com/jbboehr/handlebars-spec.git",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/extend": "^3.0.4",
		"@types/hjson": "^2.4.6",
		"@types/node": "^26.4.1",
		"@types/sinon": "^22.0.0",
		"@types/uglify-js": "^3.17.5",
		"@typescript-eslint/parser": "^8.69.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"clime": "^0.5.16",
		"eslint": "^10.10.0",
		"eslint-plugin-import-x": "^4.17.1",
		"extend": "^3.0.2",
		"handlebars": "4.7.9",
		"hjson": "^3.2.2",
		"sinon": "^22.1.0",
		"ts-node": "^10.9.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.69.0",
		"uglify-js": "^3.19.3"
	},
	"scripts": {
		"build": "tsc",
		"extractFunctions": "ts-node --files src/cli.ts extractFunctions",
		"format": "eslint --fix .",
		"lint": "eslint .",
		"generate": "ts-node --files src/cli.ts generate",
		"test": "npm run build && node --test test/*.test.mjs && node dist/cli.js testRunner",
		"testRunner": "ts-node --files src/cli.ts testRunner"
	},
	"files": [
		"docs/fixture-format.md",
		"export",
		"spec"
	]
}
